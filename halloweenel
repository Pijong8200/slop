local priority = {
"Speedrun",
"GlassBase",
"Regeneration",
"TinySlop",
"Blackout",
"Brainrot"
}

local function search()
local found = {}
for i, button in ipairs(buttons:GetChildren()) do
if i >= 2 and i <= 4 then
table.insert(found, button)
end
end
return found
end

local function call()
local foundButtons = search()
for _, n in ipairs(priority) do
for _, v in ipairs(foundButtons) do
if v.Name == n then
mutatorEvent:FireServer(
    "Vote",
    v.Name
)
return
end
end
end
end

