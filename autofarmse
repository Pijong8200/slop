--// Tower deployment
local function deploy(towerData)
	return spawnRemote:InvokeServer(unpack(towerData))
end





--// Tower upgrading


local function upgrade(towerTable)
	for _, towerData in ipairs(towerTable) do
		local towerName = towerData[1]
		local towerCFrame = towerData[2]
		local variantName = towerData[4]

		for _, towerInstance in ipairs(towersFolder:GetChildren()) do
			if towerInstance.Name == towerName then
				local towerPosition = towerInstance:GetPivot().Position
				local targetPosition = towerCFrame.Position

				if (towerPosition - targetPosition).Magnitude < 2 then
					upgradeRemote:InvokeServer(towerInstance, variantName)
					break
				end
			end
		end
	end
end


