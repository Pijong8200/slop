-- Non-blocking or structured deployment sequences
task.spawn(function()
	local function deploySequence(tower, targetCount, cost, waitTime)
		local deployed = 0
		while deployed < targetCount do
			task.wait(waitTime)
			if cash.Value >= cost then
				deploy(tower)
				deployed += 1
			end
		end
	end

	-- Run deployments concurrently using task.spawn to prevent blocking
	task.spawn(function() deploySequence(freddy, 10, 400, 1) end)
	task.spawn(function() deploySequence(slow, 4, 1250, 1) end)
	task.spawn(function() deploySequence(aliennub, 4, 800, 1) end)
	task.spawn(function() deploySequence(hc, 4, 2345, 1) end)
	task.spawn(function() deploySequence(azure, 3, 3000, 1) end)
end)

-- Optimized upgrade tracking (Prevents redundant requests)
local upgradedTowers = {}

local towersToUpgrade = {
	{"Freddy Trashcan", "Freddy Trashcan Gold"},
	{"Alien Noob", "Alien Noob"},
	{"Afterwind", "Afterwind"},
	{"Happy Computer", "Happy Computer Gold"},
	{"Azure", "Azure"}
}

task.spawn(function()
	while true do
		for _, towerInstance in ipairs(towersFolder:GetChildren()) do
			if not upgradedTowers[towerInstance] then
				for _, towerData in ipairs(towersToUpgrade) do
					local baseName, upgradeName = towerData[1], towerData[2]
					
					if towerInstance.Name == baseName then
						upgradeRemote:InvokeServer(towerInstance, upgradeName)
					end
				end
			end
		end
		task.wait(2) -- Slightly increased interval to reduce network spikes
	end
end)