-- // mutator selector
local function getPriority(text)
	if text == "2x Cash" then
		return math.huge
	end
    
	local percent = tonumber(string.match(text, "(%d+)%%"))

	return percent
end


local function selectBest(buttons)
	local bestButton = nil
	local bestPriority = -math.huge

	for _, button in ipairs(buttons) do
		local text = button.TextLabel.Text
		local priority = getPriority(text)

		if priority and priority > bestPriority then
			bestPriority = priority
			bestButton = button
		end
	end

	return bestButton
  end

