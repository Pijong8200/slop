local function getRandomOffset()
	local signX = math.random(0, 1) == 0 and -1 or 1
	local signZ = math.random(0, 1) == 0 and -1 or 1
	return Vector3.new(math.random(1, 2) * signX, 0, math.random(1, 2) * signZ)
end

local function deploy(towerData)
	local dataCopy = table.clone(towerData)
	dataCopy[2] = dataCopy[2] + getRandomOffset()
	spawnRemote:InvokeServer(unpack(dataCopy))
end

