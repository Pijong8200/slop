local function safeFire(remote, ...)
    if not remote then return false, "Remote is missing" end
    local args = table.pack(...)
    local ok, err = pcall(function() remote:FireServer(table.unpack(args, 1, args.n)) end)
    if not ok then warn("[Autofarm] FireServer failed:", remote:GetFullName(), err) end
    return ok, err
end

local function safeInvoke(remote, ...)
    if not remote then return false, "Remote is missing" end
    local args = table.pack(...)
    local packed = table.pack(pcall(function() return remote:InvokeServer(table.unpack(args, 1, args.n)) end))
    if not packed[1] then
        warn("[Autofarm] InvokeServer failed:", remote:GetFullName(), packed[2])
        return false, packed[2]
    end
    return true, table.unpack(packed, 2, packed.n)
end

local function waitForChild(parent, name, timeout)
    local child = parent:WaitForChild(name, timeout or 15)
    if not child then warn("[Autofarm] Timed out waiting for", parent:GetFullName() .. "." .. name) end
    return child
end

