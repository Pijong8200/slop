-- // rogue cards

local Event = game:GetService("ReplicatedStorage").Events.RogueCard

local priorityList = {
    "Golden Toilet",
    "Blood Pact",
    "Tunnel Vision",
    "Turbo Flush",
    "Glass Cannon",
    "Slop Power",
    "Rushed Job",
    "Sticky Slop",
    "Caffeine",
    "Long Neck",
    "Sharp Toilets"
}

local offerCount = 0

local function getPriority(title)
    for priority, wantedTitle in ipairs(priorityList) do
        if title == wantedTitle then
            return priority
        end
    end

    return math.huge
end

Event.OnClientEvent:Connect(function(action, data)
    if action ~= "Offer" then
        return
    end

    if not data or not data.Cards then
        return
    end

    -- Count which offer this is
    offerCount += 1

    local bestIndex = nil
    local bestPriority = math.huge

    for index, card in ipairs(data.Cards) do
        local priority = getPriority(card.Title)

        if priority < bestPriority then
            bestPriority = priority
            bestIndex = index
        end
    end

    if bestIndex then
        local selectedCard = data.Cards[bestIndex]

        print("Offer:", offerCount)
        print("Picking:", selectedCard.Title)
        print("Card index:", bestIndex)

        Event:FireServer(
            "Pick",
            offerCount,
            bestIndex
        )
    else
        print("No priority card found for offer", offerCount)
    end
end)


