local VIM = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")
local Player = game:GetService("Players").LocalPlayer

local function tapkey(Key, Duration)
    Duration = Duration or 0.05

    if typeof(Key) == "number" then
        Key = Enum.KeyCode[tostring(Key)] or Enum.KeyCode["One"]
    elseif typeof(Key) == "string" then
        Key = Enum.KeyCode[Key:upper()]
    end

    if not Key then return end

    VIM:SendKeyEvent(true, Key, false, game)
    task.wait(Duration)
    VIM:SendKeyEvent(false, Key, false, game)
end

local function tweentp(Target, Speed)
    local Character = Player.Character or Player.CharacterAdded:Wait()
    local HRP = Character:WaitForChild("HumanoidRootPart")

    Speed = Speed or 500

    if typeof(Target) == "Vector3" then
        Target = CFrame.new(Target)
    end

    if typeof(Target) ~= "CFrame" then return end

    local Distance = (HRP.Position - Target.Position).Magnitude
    local Duration = Distance / Speed

    local Tween = TweenService:Create(
        HRP,
        TweenInfo.new(Duration, Enum.EasingStyle.Linear),
        {CFrame = Target}
    )

    Tween:Play()
    Tween.Completed:Wait()
end

return {
    tapkey = tapkey,
    tweentp = tweentp
}