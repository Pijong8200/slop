local function raidDetected(raid)
    print("Raid detected:", raid.Name)

    if raid.Name == "Raid" or raid.Name == "Raid 1" then
        func1()

    elseif raid.Name == "Raid 2" then
        func2()

    elseif raid.Name == "Raid 3" then
