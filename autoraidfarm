        func4()
    end
end

-- Check if a Raid folder already exists
for _, child in Map:GetChildren() do
    if child:IsA("Folder") and (
        child.Name == "Raid"
        or child.Name:match("^Raid %d+$")
    ) then
        raidDetected(child)
        break
    end
end

-- Detect a Raid folder being added later
Map.ChildAdded:Connect(function(child)
    if child:IsA("Folder") and (
        child.Name == "Raid"
        or child.Name:match("^Raid %d+$")
    ) then
        raidDetected(child)
    end
end)
