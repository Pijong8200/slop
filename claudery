local function getRoot(mob)

    local root = mob:FindFirstChild("HumanoidRootPart")

    if root and root:IsA("BasePart") then
        return root
    end

    if mob:IsA("Model") and mob.PrimaryPart then
        return mob.PrimaryPart
    end

    return mob:FindFirstChildWhichIsA("BasePart")

end

-- Returns a reason string if the mob is dead / gone, nil if it is alive
local function deathReason(mob)

    if not mob or mob.Parent ~= monstersFolder then
        return "removed from Monsters folder"
    end

    local hum = mob:FindFirstChildOfClass("Humanoid")

    if hum then

        if hum.Health < DEATH.MinHealth then
            return "humanoid health below " .. DEATH.MinHealth
        end

        if hum:GetState() == Enum.HumanoidStateType.Dead then
            return "humanoid state is Dead"
        end

    end

    for _, name in ipairs(DEATH.FlagNames) do

        if mob:GetAttribute(name) == true then
            return "attribute " .. name
        end

        local obj = mob:FindFirstChild(name)

        if obj and obj:IsA("BoolValue") and obj.Value then
            return "BoolValue " .. name
        end

    end

    for _, name in ipairs(DEATH.HealthNames) do

        local attr = mob:GetAttribute(name)

        if type(attr) == "number" and attr < DEATH.MinHealth then
            return "attribute " .. name .. " below " .. DEATH.MinHealth
        end

        local obj = mob:FindFirstChild(name)

        if obj
            and (obj:IsA("NumberValue") or obj:IsA("IntValue"))
            and obj.Value < DEATH.MinHealth then

            return "value " .. name .. " below " .. DEATH.MinHealth

        end

    end

    if not getRoot(mob) then
        return "no root part"
    end

    return nil

end


