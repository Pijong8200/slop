local function disconnectTarget()

    for _, connection in ipairs(targetConnections) do
        connection:Disconnect()
    end

    table.clear(targetConnections)

end

local function clearTarget()

    disconnectTarget()

    state.target = nil
    state.inRange = false

end


--==================================================
-- FIND NEAREST ALIVE MOB
--==================================================

local function getNearestMob(fromPosition, ignore)

    local closestMob = nil
    local shortestDistance = math.huge

    for _, mob in ipairs(monstersFolder:GetChildren()) do

        if mob ~= ignore and not deathReason(mob) then

            local root = getRoot(mob)

            if root then

                local distance = (fromPosition - root.Position).Magnitude

                if distance < shortestDistance then
                    shortestDistance = distance
                    closestMob = mob
                end

            end

        end

    end

    return closestMob

end


--==================================================
-- TARGET WATCHING + ACQUISITION
--==================================================

local acquireTarget -- defined below, watchTarget needs it

-- Every signal that can mean "this mob died" re-checks it instantly
-- and swaps the target inside the same callback (no defer, no waiting for a frame)
local function watchTarget(mob)

    local function onChange()

        if state.target ~= mob then
            return
        end

        local reason = deathReason(mob)

        if reason then
            debugPrint("target dead (" .. reason .. "):", mob.Name)
            acquireTarget(mob)
        end

    end

    local function watch(signal)
        table.insert(targetConnections, signal:Connect(onChange))
    end

    local humanoid = mob:FindFirstChildOfClass("Humanoid")

    if humanoid then
        watch(humanoid.HealthChanged)
        watch(humanoid.Died)
        watch(humanoid.StateChanged)
    end

    watch(mob.AncestryChanged)
    watch(mob.AttributeChanged)
    watch(mob.ChildRemoved)

    for _, list in ipairs({ DEATH.FlagNames, DEATH.HealthNames }) do

        for _, name in ipairs(list) do

            local obj = mob:FindFirstChild(name)

            if obj and obj:IsA("ValueBase") then
                watch(obj.Changed)
            end

        end

    end

end

acquireTarget = function(ignore)

    clearTarget()

    if not state.running or not state.enabled then
        return
    end

    local myRoot = getMyRoot()

    if not myRoot then
        return
    end

    local mob = getNearestMob(myRoot.Position, ignore)

    if not mob then
        return
    end

    local root = getRoot(mob)

    state.target = mob
    state.inRange = (root.Position - myRoot.Position).Magnitude <= SETTINGS.AttackRange

    watchTarget(mob)

    debugPrint("new target:", mob.Name)

    if SETTINGS.DebugDump then
        dumpMob(mob)
    end

end

-- Returns true if there is a living target (swaps instantly if the old one is dead)
local function refreshTarget()

    local mob = state.target

    if mob then

        local reason = deathReason(mob)

        if not reason then
            return true
        end

        debugPrint("target dead (" .. reason .. "):", mob.Name)

    end

    acquireTarget(mob)

    return state.target ~= nil

end

-- Called right before every attack / cast
local function canAttack()

    if not state.enabled then
        return false
    end

    if not refreshTarget() then
        return false
    end

    return state.inRange

end


--==================================================
-- MOVEMENT (+ spin)
--==================================================

local function step(deltaTime)

    if not state.enabled then
        return
    end

    local myRoot = getMyRoot()

    if not myRoot then
        clearTarget()
        return
    end

    if not refreshTarget() then
        return
    end

    local root = getRoot(state.target)

    local myPosition = myRoot.Position
    local targetPosition = root.Position

    -- Stand in front of the enemy
    local standPosition = targetPosition + root.CFrame.LookVector * SETTINGS.StopDistance
    local offset = standPosition - myPosition
    local distance = offset.Magnitude

    state.inRange = (targetPosition - myPosition).Magnitude <= SETTINGS.AttackRange

    local newPosition = standPosition

    if distance > 0.05 then

        local maxStep = SETTINGS.Speed * deltaTime

        if maxStep < distance then
            newPosition = myPosition + offset.Unit * maxStep
        end

    end

    local lookAt = Vector3.new(targetPosition.X, newPosition.Y, targetPosition.Z)

    if (lookAt - newPosition).Magnitude > 0.01 then

        -- face the mob, then add the Skill 1 spin on top (0 when not spinning)
        myRoot.CFrame = CFrame.lookAt(newPosition, lookAt) * CFrame.Angles(0, advanceSpin(deltaTime), 0)

    else

        myRoot.CFrame = CFrame.new(newPosition) * myRoot.CFrame.Rotation

    end

    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero

end


