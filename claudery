--==================================================
-- CASTER THREAD (priority list, casts the moment a skill is ready)
--==================================================

local lastFired = {}
local lastCastAt = 0

local function isReady(kind, index, now)

    local key = kind .. index

    if now - (lastFired[key] or 0) < SETTINGS.RecastGuard then
        return false
    end

    return cooldownLeft(kind, index) <= SETTINGS.ReadyWithin

end

-- priority[1] is checked first every frame, so Skill 1 always wins when it is ready.
-- At most one cast per frame (the highest-priority ready skill), no fixed waits.
local function startCasterLoop(priority)

    task.spawn(function()

        while state.running do

            if #priority > 0 and canAttack() then

                local now = os.clock()

                if now - lastCastAt >= SETTINGS.CastGap then

                    for _, entry in ipairs(priority) do

                        if isReady(entry[1], entry[2], now) then

                            if castSkill(entry[1], entry[2]) then
                                lastFired[entry[1] .. entry[2]] = now
                                lastCastAt = now
                                debugPrint("cast", entry[1] .. entry[2])
                            end

                            break

                        end

                    end

                end

            end

            RunService.Heartbeat:Wait()

        end

    end)

end


--==================================================
-- AUTO SELL CARDS
--==================================================

local sellRarities = {}

for _, rarity in ipairs(AUTO_SELL.Rarities) do
    sellRarities[string.lower(rarity)] = true
end

local function looksLikeInventory(object)

    return type(object) == "table"
        and type(rawget(object, "Cards")) == "table"
        and type(rawget(object, "CardSlots")) == "table"

end

-- InventoryModule keeps its Inventory object private, so grab it from the
-- module's upvalues (or from the garbage collector as a fallback).
local function findInventory()

    local module = safeRequire(Player:WaitForChild("PlayerGui"), "Modules", "InventoryModule")

    local getUpvalue = (debug and debug.getupvalue) or getupvalue

    if type(module) == "table" and type(getUpvalue) == "function" then

        for _, name in ipairs({ "createCardDataEntry", "refreshInventory", "updateSlot", "UpdateEntry" }) do

            local fn = module[name]

            if type(fn) == "function" then

                for index = 1, 6 do

                    local ok, value = pcall(getUpvalue, fn, index)

                    if ok and looksLikeInventory(value) then
                        return value
                    end

                end

            end

        end

    end

    if type(getgc) == "function" then

        local ok, objects = pcall(getgc, true)

        if ok and type(objects) == "table" then

            for _, object in ipairs(objects) do

                if looksLikeInventory(object) then
                    return object
                end

            end

        end

    end

    return nil

end

local function isInOtherLoadout(inventory, uiModule, id)

    local items = inventory.OtherLoadoutItems

    if type(items) == "table" and items[id] ~= nil then
        return true
    end

    if type(uiModule) == "table" and type(uiModule.isInOtherLoadout) == "function" then

        local ok, result = pcall(uiModule.isInOtherLoadout, id)

        if ok and result then
            return true
        end

    end

    return false

end

local function collectSellableCards(inventory, cardInfo, uiModule)

    local ids = {}
    local seen = {}

    for id, card in pairs(inventory.Cards) do

        if type(card) == "table" then

            local info = cardInfo[card.CardName]

            if info then

                local rarity = card.IsDivine and "Divine" or info.rarity

                if type(rarity) == "string" then
                    seen[rarity] = (seen[rarity] or 0) + 1
                end

                local sellable = type(rarity) == "string"
                    and sellRarities[string.lower(rarity)]
                    and not card.Locked
                    and not card.Equipped
                    and not card.IsDivine
                    and not (AUTO_SELL.SkipLimited and info.Limited)

                if sellable and not isInOtherLoadout(inventory, uiModule, id) then
                    table.insert(ids, id)
                end

            end

        end

    end

    if SETTINGS.Debug then

        for rarity, count in pairs(seen) do
            print("[Farm Engine] auto-sell saw rarity:", rarity, count)
        end

    end

    return ids

end

local lastSellMessage = nil

local function sellPass(inventory, cardInfo, uiModule)

    local ids = collectSellableCards(inventory, cardInfo, uiModule)

    if #ids == 0 then
        debugPrint("auto-sell: nothing to sell")
        return
    end

    local remote = getRemote("Function")

    if not remote then
        warn("[Farm Engine] MainRemoteFunction not found, can't sell")
        return
    end

    for first = 1, #ids, AUTO_SELL.BatchSize do

        if not state.alive then
            return
        end

        local last = math.min(first + AUTO_SELL.BatchSize - 1, #ids)
        local batch = {}

        for i = first, last do
            batch[ids[i]] = true
        end

        -- Same call the game's mass sell button makes
        local ok, result = pcall(function()
            return remote:InvokeServer("MassDeleteCardsFromInventory", batch)
        end)

        local message = describeResult(ok, result)

        if message ~= lastSellMessage or SETTINGS.Debug then
            print("[Farm Engine] Auto-sell:", last - first + 1, "cards ->", message)
        end

        lastSellMessage = message

        task.wait(0.5)

    end

end

local function startAutoSell()

    task.spawn(function()

        local inventory = nil

        for _ = 1, 30 do

            if not state.alive then
                return
            end

            inventory = findInventory()

            if inventory then
                break
            end

            task.wait(2)

        end

        if not inventory then
            warn("[Farm Engine] Auto-sell off: couldn't reach the Inventory object (needs getupvalue or getgc)")
            return
        end

        local settingsModule = safeRequire(ReplicatedStorage, "Modules", "settings")
        local cardInfo = type(settingsModule) == "table" and settingsModule.CardInfo

        if not cardInfo then
            warn("[Farm Engine] Auto-sell off: settings.CardInfo not found")
            return
        end

        local uiModule = safeRequire(Player:WaitForChild("PlayerGui"), "Modules", "UIModule")

        print("[Farm Engine] Auto-sell on:", table.concat(AUTO_SELL.Rarities, ", "))

        while state.alive do

            sellPass(inventory, cardInfo, uiModule)

            task.wait(AUTO_SELL.Interval)

        end

    end)

end


--==================================================
-- AUTO ROOM (create + start when workspace.Leaderboards exists)
--==================================================

local function startRoomFlow()

    task.spawn(function()

        while state.alive and not workspace:FindFirstChild("Leaderboards") do
            task.wait(1)
        end

        if not state.alive then
            return
        end

        print("[Farm Engine] Leaderboards found, creating room")

        task.wait(ROOM.DetectDelay)

        -- Create (retry until the server accepts it)
        local created = false

        for attempt = 1, ROOM.Retries do

            if not state.alive then
                return
            end

            local remote = getRemote("Function")

            if not remote then
                warn("[Farm Engine] MainRemoteFunction not found, can't create room")
                return
            end

            local ok, result = pcall(function()
                return remote:InvokeServer("CreateRoom", ROOM.Request)
            end)

            if ok and type(result) == "table" and result.status == "Success" then
                created = true
                print("[Farm Engine] Room created:", ROOM.Request.MapName, ROOM.Request.Difficulty)
                break
            end

            print("[Farm Engine] CreateRoom failed (" .. attempt .. "/" .. ROOM.Retries .. "):", describeResult(ok, result))

            task.wait(ROOM.RetryDelay)

        end

        if not created then
            return
        end

        task.wait(ROOM.StartDelay)

        -- Start (retry a few times in case the server wants a moment)
        for attempt = 1, ROOM.Retries do

            if not state.alive then
                return
            end

            local remote = getRemote("Function")

            if not remote then
                return
            end

            local ok, result = pcall(function()
                return remote:InvokeServer("TeleportPlayers")
            end)

            if ok and type(result) == "table" and result.status == "Success" then
                print("[Farm Engine] Room started")
                return
            end

            print("[Farm Engine] TeleportPlayers failed (" .. attempt .. "/" .. ROOM.Retries .. "):", describeResult(ok, result))

            task.wait(ROOM.RetryDelay)

        end

    end)

end


--==================================================
-- STOP / START
--==================================================

local function stopFarm()

    state.alive = false
    state.running = false
    state.enabled = false

    clearTarget()

    for _, connection in ipairs(engineConnections) do
        connection:Disconnect()
    end

    table.clear(engineConnections)

end

local function startFarm(sequence)

    sequence = sequence or {}

    local priority = sequence.priority or {}

    state.running = true
    state.enabled = true

    -- Initial setup casts
    for _, entry in ipairs(sequence.setup or {}) do
        castSkill(entry[1], entry[2])
        task.wait(0.1)
    end

    if not state.running then
        return
    end

    -- Movement + safety checks
    table.insert(engineConnections, RunService.Heartbeat:Connect(step))

    table.insert(engineConnections, RunService.PreRender:Connect(function()

        if state.enabled then
            refreshTarget()
        end

    end))

    -- Grab a target the moment a mob spawns while idle
    table.insert(engineConnections, monstersFolder.ChildAdded:Connect(function()

        if state.enabled and not state.target then
            refreshTarget()
        end

    end))

    -- Pause / resume key
    table.insert(engineConnections, UserInputService.InputBegan:Connect(function(input, processed)

        if processed then
            return
        end

        if input.KeyCode == SETTINGS.ToggleKey then

            state.enabled = not state.enabled

            if not state.enabled then
                clearTarget()
            end

            print("[Farm Engine]", state.enabled and "Resumed" or "Paused")

        end

    end))

    startClickLoop()
    startCasterLoop(priority)

    refreshTarget()

    local names = {}

    for _, entry in ipairs(priority) do
        table.insert(names, entry[1] .. entry[2])
    end

    print("[Farm Engine] Running")
    print("[Farm Engine] Death detection: health < " .. DEATH.MinHealth .. ", Died, state, flags, removal")
    print("[Farm Engine] Cast priority (cast the moment ready):", table.concat(names, " > "))
    print("[Farm Engine] Skill 1 spin:", SPIN.Enabled and (SPIN.Spins .. " turns per " .. SPIN.Duration .. "s, stacking") or "off")
    print("[Farm Engine] Speed:", SETTINGS.Speed)
    print("[Farm Engine] Pause / resume key:", SETTINGS.ToggleKey.Name)

end

local function waitForMonstersFolder()

    while state.alive do

        local folders = workspace:FindFirstChild("Folders")
        local folder = folders and folders:FindFirstChild("Monsters")

        if folder then
            return folder
        end

        task.wait(1)

    end

    return nil

end


