-- require(root.A.B.C) with waits, never throws
local function safeRequire(root, ...)

    local path = { ... }

    local ok, result = pcall(function()

        local node = root

        for _, name in ipairs(path) do
            node = node and node:WaitForChild(name, 10)
        end

        return node and require(node)

    end)

    if ok then
        return result
    end

    return nil

end

local directoryCache = nil

local function getDirectory()

    if not directoryCache then
        directoryCache = safeRequire(ReplicatedStorage, "Modules", "Directory")
    end

    return directoryCache

end

local REMOTE_INFO = {
    Event = { class = "RemoteEvent", name = "MainRemoteEvent", group = "RemoteEvents" },
    Function = { class = "RemoteFunction", name = "MainRemoteFunction", group = "RemoteFunctions" },
}

local remoteCache = {}

-- kind = "Event" (MainRemoteEvent) or "Function" (MainRemoteFunction)
local function getRemote(kind)

    local cached = remoteCache[kind]

    if cached and cached.Parent then
        return cached
    end

    local info = REMOTE_INFO[kind]
    local remote = nil
    local directory = getDirectory()

    if type(directory) == "table" and type(directory[info.group]) == "table" then
        remote = directory[info.group][info.name]
    end

    -- Fallback: search ReplicatedStorage by name
    if typeof(remote) ~= "Instance" then
        remote = ReplicatedStorage:FindFirstChild(info.name, true)
    end

    if typeof(remote) == "Instance" and remote:IsA(info.class) then
        remoteCache[kind] = remote
        return remote
    end

    return nil

end

local function describeResult(ok, result)

    if not ok then
        return tostring(result)
    end

    if type(result) == "table" and result.message ~= nil then
        return tostring(result.message)
    end

    return tostring(result)

end

-- The game's own ClientSkillModule, only used to read cooldowns (loaded in the bootstrap)
local skillModule = nil

-- Seconds of cooldown left. Keys are the ones the module uses: 1-5, "Assist1", "Fruit2", ...
local function cooldownLeft(kind, index)

    if type(skillModule) ~= "table" or type(skillModule.returnCooldown) ~= "function" then
        return 0
    end

    local key = kind == "Skill" and index or (kind .. index)
    local ok, value = pcall(skillModule.returnCooldown, key)

    if ok and type(value) == "number" then
        return value
    end

    return 0

end


--==================================================
-- SKILL 1 SPIN (360, fast, stacks)
--==================================================

local TAU = math.pi * 2
local SPIN_RATE = SPIN.Spins / SPIN.Duration -- revolutions per second

local spinUntil = 0
local spinAngle = 0

-- Every Skill 1 cast adds SPIN.Duration on top of whatever spin time is left
local function extendSpin()

    if not SPIN.Enabled then
        return
    end

    local now = os.clock()

    spinUntil = math.min(math.max(spinUntil, now) + SPIN.Duration, now + SPIN.MaxDuration)

end

-- Returns the extra yaw (radians) to add this frame.
-- When the time runs out it still finishes the current turn, so it ends facing the mob.
local function advanceSpin(deltaTime)

    local now = os.clock()

    if now >= spinUntil and spinAngle == 0 then
        return 0
    end

    spinAngle = spinAngle + deltaTime * SPIN_RATE * TAU

    if spinAngle >= TAU then

        if now < spinUntil then
            spinAngle = spinAngle - TAU
        else
            spinAngle = 0
        end

    end

    return spinAngle

end


--==================================================
-- CASTING + BASIC ATTACK (remotes only, no key / mouse input)
--==================================================

-- Same remotes + payload the game's ClientSkillModule fires
local CAST_ACTIONS = {
    Skill = "UseSkill",         -- keys 1-5
    Assist = "UseAssistSkill",  -- keys E / R
    Fruit = "UseFruitSkill",    -- keys Z / X
}

-- The CFrame we report to the server: our position, facing the target.
-- Keeps every cast / attack pointed at the mob even while the character is spinning.
local function aimCFrame(root)

    local targetRoot = state.target and getRoot(state.target)

    if targetRoot then

        local flat = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)

        if (flat - root.Position).Magnitude > 0.01 then
            return CFrame.lookAt(root.Position, flat)
        end

    end

    return root.CFrame

end

local function castSkill(kind, index)

    local action = CAST_ACTIONS[kind]
    local root = getMyRoot()
    local remote = getRemote("Event")

    if not (action and root and remote) then
        return false
    end

    remote:FireServer(action, { hrpCFrame = aimCFrame(root) }, index)

    if kind == "Skill" and index == 1 then
        extendSpin()
    end

    return true

end

-- One basic attack remote, always as combo 1 (no combo counting)
local function basicAttack()

    local root = getMyRoot()
    local remote = getRemote("Event")

    if not (root and remote) then
        return false
    end

    -- attackNumber is the normal key, combo is what the custom basic attacks read; both = 1
    remote:FireServer("UseSkill", {
        attackNumber = 1,
        combo = 1,
        hrpCFrame = aimCFrame(root),
    }, "BasicAttack")

    return true

end


