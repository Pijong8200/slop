-- Hourly accessory counter
local accessoryCount = 0
local currentHour = os.date("%Y-%m-%d %H")

local function updateHour()
    local newHour = os.date("%Y-%m-%d %H")

    if newHour ~= currentHour then
        currentHour = newHour
        accessoryCount = 0

        print("New hour! Accessory counter reset.")
    end
end

-- Extract reward name and amount
local function getReward(child)
    local name = child.Name:gsub("%s*ImageLabel$", "")
    local amount
    local isAccessory = name:match("^%d+$") ~= nil

    -- Numeric reward names represent accessories
    if isAccessory then
        name = "Accessory"
    end

    for _, descendant in ipairs(child:GetDescendants()) do
        if descendant:IsA("TextLabel") then
            local text = descendant.Text:match("^%s*(.-)%s*$")
            local number = text:match("^[x×]?(%d+)$")

            if number then
                amount = tonumber(number)
                break
            end
        end
    end

    -- Count actual accessory quantity
    if isAccessory then
        accessoryCount += amount or 1
    end

    return amount and (name .. " x" .. amount) or name
end

local function getCompletionTime()
    return TimeText.Text:gsub("^%s*Time:%s*", "")
end

-- Send webhook
local function sendRewards()
    if #rewards == 0 or sending then return end

    sending = true

    updateHour()

    local snapshot = table.clone(rewards)

    local rewardText = table.concat(snapshot, "\n")
    local completionTime = getCompletionTime()
    local pity = PityCount.Text
    local currentTimeText = os.date("%I:%M:%S %p")

    local payload = {
        embeds = {{
            title = "🏆 Reward Results",
            description = "```text\n" .. rewardText .. "\n```",
            color = 5793266,

            fields = {
                {
                    name = "⏱️ Completion Time",
                    value = completionTime,
                    inline = true
                },
                {
                    name = "💎 Accessory Pity",
                    value = pity,
                    inline = true
                },
                {
                    name = "🎁 Accessories This Hour",
                    value = tostring(accessoryCount),
                    inline = true
                },
                {
                    name = "🕒 Received At",
                    value = currentTimeText,
                    inline = false
                }
            },

            timestamp = DateTime.now():ToIsoDate(),

            footer = {
                text = "Reward Logger • Hourly Tracker"
            }
        }}
    }

    local body = HttpService:JSONEncode(payload)
    local success = false

    for attempt = 1, 3 do
        local ok, response = pcall(function()
            return Request({
                Url = Webhook,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = body
            })
        end)

        if ok and response then
            local status = response.StatusCode

            if (status and status >= 200 and status < 300)
                or response.Success == true then
                success = true
                break
            end

            warn("Webhook HTTP error:", status, response.StatusMessage)
        else
            warn("Webhook request failed:", response)
        end

        if attempt < 3 then
            task.wait(attempt * 2)
        end
    end

    if success then
        for _ = 1, #snapshot do
            table.remove(rewards, 1)
        end

        print("Reward webhook sent successfully!")
    else
        warn("Webhook failed after 3 attempts. Rewards retained.")
    end

    sending = false

    if #rewards > 0 then
        task.delay(2, sendRewards)
    end
end

