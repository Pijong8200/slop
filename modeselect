local CoreGui = game:GetService("CoreGui")
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "QueueSelectorMenu"
screenGui.Parent = CoreGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 160, 0, 75)
frame.Position = UDim2.new(1, -170, 0, 10)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local uiCornerFrame = Instance.new("UICorner")
uiCornerFrame.CornerRadius = UDim.new(0, 6)
uiCornerFrame.Parent = frame

local function createButton(name, text, color, yPosition)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, -20, 0, 25)
    btn.Position = UDim2.new(0, 10, 0, yPosition)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.Parent = frame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    
    return btn
end

local btnA = createButton("BtnA", "Queue Script A", Color3.fromRGB(50, 120, 200), 10)   -- Blue Button
local btnB = createButton("BtnB", "Queue Script B", Color3.fromRGB(50, 160, 100), 40)   -- Green Button

local function clearChoices()
    if delfile then
        pcall(function() delfile("run_script_A.txt") end)
        pcall(function() delfile("run_script_B.txt") end)
    end
end

btnA.MouseButton1Click:Connect(function()
    if writefile then
        clearChoices()
        writefile("run_script_A.txt", "true")
        btnA.Text = "Script A Queued!"
        btnB.Text = "Queue Script B"
    end
end)

btnB.MouseButton1Click:Connect(function()
    if writefile then
        clearChoices()
        writefile("run_script_B.txt", "true")
        btnB.Text = "Script B Queued!"
        btnA.Text = "Queue Script A"
    end
end)
