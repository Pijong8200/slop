-- Create the Selection UI Menu
local CoreGui = game:GetService("CoreGui")
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "InstantScriptRunner"
screenGui.Parent = CoreGui

-- Main Container Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 160, 0, 75)
frame.Position = UDim2.new(1, -170, 0, 10) -- Top right corner
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local uiCornerFrame = Instance.new("UICorner")
uiCornerFrame.CornerRadius = UDim.new(0, 6)
uiCornerFrame.Parent = frame

-- Helper function to quickly make styled buttons
local function createButton(name, text, color, yPosition)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, -20, 0, 25)
    btn.Position = UDim2.new(0, 10, 0, yPosition)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.Parent = frame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    
    return btn
end

-- Labeled buttons for Raid and Endless modes
local btnRaid = createButton("BtnRaid", "Run Raid", Color3.fromRGB(200, 60, 60), 10)       -- Red Button
local btnEndless = createButton("BtnEndless", "Run Endless", Color3.fromRGB(50, 140, 200), 40) -- Blue Button

-- Button Functionality (Runs instantly and closes the menu)
btnRaid.MouseButton1Click:Connect(function()
    screenGui:Destroy() -- Removes the menu so it doesn't clutter your screen
    loadstring(game:HttpGet("https://raw.githubusercontent.com/Pijong8200/slop/refs/heads/main/autoraidfarm"))()
end)

btnEndless.MouseButton1Click:Connect(function()
    screenGui:Destroy() -- Removes the menu so it doesn't clutter your screen
    -- CHANGE THIS to your actual Endless script GitHub link!
    loadstring(game:HttpGet("https://raw.githubusercontent.com/Pijong8200/slop/refs/heads/main/autofarmse"))()
end)